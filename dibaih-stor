<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#17452d">
<title>ذبيحة | متجر الذبائح واللحوم</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--green:#17452d;
--green2:#236542;
--gold:#d9ae58;
--cream:#f7f5ef;
--white:#fff;
--text:#1d241f;
--muted:#777;
--red:#c94b45;
}

body{
font-family:Tahoma,Arial,sans-serif;
background:var(--cream);
color:var(--text);
padding-bottom:75px;
}

button,input,select{
font-family:inherit;
}

button{
cursor:pointer;
border:0;
}

a{
text-decoration:none;
color:inherit;
}

img{
display:block;
width:100%;
object-fit:cover;
}

/* HEADER */

.header{
position:sticky;
top:0;
z-index:100;
background:#fff;
box-shadow:0 2px 15px #00000010;
}

.header-inner{
height:68px;
max-width:1250px;
margin:auto;
padding:0 18px;
display:flex;
align-items:center;
gap:15px;
}

.logo{
font-size:27px;
font-weight:900;
color:var(--green);
white-space:nowrap;
}

.search{
flex:1;
position:relative;
}

.search input{
width:100%;
border:1px solid #e2e2df;
background:#f7f7f5;
border-radius:13px;
padding:12px 42px 12px 15px;
outline:none;
}

.search-icon{
position:absolute;
right:13px;
top:10px;
font-size:19px;
}

.header-actions{
display:flex;
gap:8px;
}

.icon-btn{
background:#f3f4f0;
width:44px;
height:44px;
border-radius:12px;
font-size:19px;
position:relative;
}

.badge{
position:absolute;
top:-5px;
left:-5px;
background:var(--gold);
font-size:11px;
min-width:19px;
height:19px;
border-radius:50%;
display:grid;
place-items:center;
}

/* APP */

.app{
max-width:1250px;
margin:auto;
padding:0 18px;
}

/* HERO */

.hero{
margin-top:20px;
min-height:390px;
border-radius:27px;
overflow:hidden;
position:relative;
background:
linear-gradient(90deg,#123b28ee,#205b3ccc),
url("https://images.unsplash.com/photo-1603048297172-c92544798d5a?auto=format&fit=crop&w=1600&q=85");
background-size:cover;
background-position:center;
color:white;
display:flex;
align-items:center;
}

.hero-content{
padding:45px;
max-width:650px;
}

.hero-label{
color:#e7c673;
font-weight:bold;
}

.hero h1{
font-size:47px;
line-height:1.25;
margin:15px 0;
}

.hero p{
line-height:2;
color:#e8eee9;
}

.primary{
background:var(--gold);
color:#182219;
font-weight:bold;
padding:13px 25px;
border-radius:12px;
margin-top:20px;
}

/* SECTION */

section{
margin-top:42px;
}

.section-head{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:18px;
}

.section-head h2{
font-size:25px;
}

.section-head button{
background:none;
color:var(--green);
font-weight:bold;
}

/* CATEGORIES */

.categories{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:14px;
}

.category{
background:white;
border-radius:19px;
overflow:hidden;
box-shadow:0 5px 20px #00000008;
cursor:pointer;
transition:.2s;
}

.category:hover{
transform:translateY(-4px);
}

.category img{
height:145px;
}

.category div{
padding:14px;
font-weight:bold;
}

/* PRODUCTS */

.products{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:18px;
}

.product{
background:white;
border-radius:19px;
overflow:hidden;
box-shadow:0 5px 20px #00000008;
position:relative;
}

.product-image{
height:205px;
position:relative;
}

.product-image img{
height:100%;
}

.favorite{
position:absolute;
top:10px;
left:10px;
width:38px;
height:38px;
border-radius:50%;
background:#ffffffe8;
font-size:18px;
}

.favorite.active{
color:var(--red);
}

.product-info{
padding:15px;
}

.product-info h3{
font-size:17px;
margin-bottom:8px;
}

.product-desc{
color:var(--muted);
font-size:13px;
line-height:1.7;
min-height:42px;
}

.product-bottom{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:13px;
}

.price{
font-size:18px;
font-weight:bold;
color:var(--green);
}

.add{
background:var(--green);
color:#fff;
padding:10px 14px;
border-radius:10px;
}

/* OFFER */

.offer{
margin-top:40px;
border-radius:23px;
padding:32px;
color:#fff;
background:
linear-gradient(90deg,#17452dee,#286746dd),
url("https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=1400&q=80");
background-size:cover;
}

.offer h2{
font-size:29px;
margin:10px 0;
}

.coupon{
display:inline-block;
background:var(--gold);
color:#172019;
padding:10px 18px;
border-radius:10px;
font-weight:bold;
margin-top:12px;
}

/* TRACK */

.track{
background:#fff;
padding:22px;
border-radius:18px;
display:flex;
gap:10px;
flex-wrap:wrap;
}

.track input{
flex:1;
min-width:220px;
padding:13px;
border:1px solid #ddd;
border-radius:11px;
outline:none;
}

.track button{
background:var(--green);
color:#fff;
padding:13px 23px;
border-radius:11px;
}

.track-result{
width:100%;
margin-top:10px;
}

/* PAGES */

.page{
display:none;
padding-top:25px;
}

.page.active{
display:block;
}

/* BACK */

.back{
background:#fff;
padding:10px 15px;
border-radius:11px;
margin-bottom:20px;
}

/* PRODUCT DETAILS */

.details{
background:#fff;
border-radius:22px;
padding:20px;
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
}

.details-image{
height:420px;
border-radius:17px;
overflow:hidden;
}

.details-image img{
height:100%;
}

.details-info{
padding:15px;
}

.details-info h1{
font-size:32px;
margin-bottom:15px;
}

.details-info p{
color:#666;
line-height:2;
}

.details-price{
font-size:28px;
font-weight:bold;
color:var(--green);
margin:20px 0;
}

.qty{
display:flex;
align-items:center;
gap:12px;
margin:20px 0;
}

.qty button{
width:38px;
height:38px;
border-radius:9px;
background:#eee;
font-size:20px;
}

.qty span{
font-weight:bold;
font-size:18px;
}

/* CART */

.cart-list{
display:flex;
flex-direction:column;
gap:12px;
}

.cart-item{
background:#fff;
padding:15px;
border-radius:16px;
display:flex;
align-items:center;
gap:15px;
}

.cart-item img{
width:90px;
height:75px;
border-radius:12px;
}

.cart-item-info{
flex:1;
}

.cart-controls{
display:flex;
align-items:center;
gap:8px;
margin-top:8px;
}

.cart-controls button{
width:30px;
height:30px;
border-radius:7px;
background:#eee;
}

.delete{
color:var(--red);
background:none!important;
}

/* SUMMARY */

.summary{
background:#fff;
padding:20px;
border-radius:18px;
margin-top:20px;
}

.summary-row{
display:flex;
justify-content:space-between;
padding:9px 0;
}

.summary-total{
border-top:1px solid #eee;
margin-top:10px;
padding-top:15px;
font-size:20px;
font-weight:bold;
}

.checkout-btn{
width:100%;
background:var(--green);
color:#fff;
padding:14px;
border-radius:11px;
margin-top:15px;
font-weight:bold;
}

/* FORM */

.form{
background:#fff;
border-radius:18px;
padding:22px;
}

.form-group{
margin-bottom:15px;
}

.form-group label{
display:block;
font-weight:bold;
margin-bottom:7px;
}

.form-group input,
.form-group textarea,
.form-group select{
width:100%;
padding:13px;
border:1px solid #ddd;
border-radius:10px;
outline:none;
}

.form-group textarea{
height:100px;
resize:none;
}

/* PAYMENT */

.payment{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:12px;
margin-top:10px;
}

.payment-option{
background:#f7f7f5;
padding:18px;
border-radius:13px;
text-align:center;
border:2px solid transparent;
}

.payment-option.selected{
border-color:var(--green);
background:#edf5ef;
}

/* ORDERS */

.order{
background:#fff;
padding:20px;
border-radius:17px;
margin-bottom:12px;
}

.order-top{
display:flex;
justify-content:space-between;
}

.status{
background:#fff3d5;
color:#956f20;
padding:5px 10px;
border-radius:20px;
font-size:12px;
}

.order-items{
color:#777;
margin-top:10px;
font-size:14px;
}

.order-action{
margin-top:14px;
background:var(--green);
color:#fff;
padding:9px 14px;
border-radius:9px;
}

/* ACCOUNT */

.account-card{
background:linear-gradient(135deg,#17452d,#2d714b);
color:#fff;
padding:25px;
border-radius:22px;
}

.points{
font-size:34px;
font-weight:bold;
margin-top:10px;
color:#e4c16f;
}

.account-menu{
background:#fff;
margin-top:15px;
border-radius:18px;
overflow:hidden;
}

.account-item{
padding:17px;
border-bottom:1px solid #eee;
display:flex;
justify-content:space-between;
}

/* BOTTOM NAV */

.bottom-nav{
position:fixed;
bottom:0;
left:0;
right:0;
height:67px;
background:#fff;
box-shadow:0 -3px 20px #00000012;
display:flex;
justify-content:center;
z-index:200;
}

.bottom-inner{
width:min(600px,100%);
display:grid;
grid-template-columns:repeat(5,1fr);
}

.bottom-item{
background:none;
color:#777;
font-size:11px;
display:flex;
flex-direction:column;
gap:4px;
align-items:center;
justify-content:center;
}

.bottom-item.active{
color:var(--green);
font-weight:bold;
}

.bottom-item span:first-child{
font-size:20px;
}

/* MODAL */

.modal{
position:fixed;
inset:0;
background:#0008;
display:none;
align-items:center;
justify-content:center;
z-index:500;
padding:20px;
}

.modal.show{
display:flex;
}

.modal-box{
background:#fff;
width:min(500px,100%);
border-radius:20px;
padding:25px;
max-height:90vh;
overflow:auto;
}

.modal-close{
float:left;
background:none;
font-size:28px;
}

/* TOAST */

.toast{
position:fixed;
bottom:85px;
left:50%;
transform:translateX(-50%) translateY(100px);
background:#18251d;
color:#fff;
padding:13px 20px;
border-radius:12px;
z-index:1000;
transition:.3s;
opacity:0;
}

.toast.show{
transform:translateX(-50%) translateY(0);
opacity:1;
}

/* RESPONSIVE */

@media(max-width:950px){

.categories{
grid-template-columns:repeat(3,1fr);
}

.products{
grid-template-columns:repeat(3,1fr);
}

}

@media(max-width:700px){

.header-inner{
height:62px;
}

.logo{
font-size:22px;
}

.search{
display:none;
}

.hero{
min-height:330px;
}

.hero-content{
padding:28px;
}

.hero h1{
font-size:31px;
}

.categories{
grid-template-columns:repeat(2,1fr);
}

.products{
grid-template-columns:repeat(2,1fr);
gap:10px;
}

.product-image{
height:145px;
}

.details{
grid-template-columns:1fr;
}

.details-image{
height:300px;
}

.payment{
grid-template-columns:1fr;
}

}

@media(max-width:430px){

.app{
padding:0 12px;
}

.hero{
margin-top:12px;
border-radius:20px;
}

.products{
gap:8px;
}

.product-info{
padding:11px;
}

.product-info h3{
font-size:14px;
}

.product-desc{
font-size:11px;
}

.price{
font-size:15px;
}

.add{
font-size:12px;
padding:9px;
}

.category img{
height:110px;
}

}
</style>
</head>

<body>

<!-- HEADER -->

<header class="header">

<div class="header-inner">

<div class="logo">ذبيحة</div>

<div class="search">

<span class="search-icon">🔎</span>

<input
id="searchInput"
placeholder="ابحث عن ذبيحة، لحم، دواجن..."
oninput="searchProducts()"
>

</div>

<div class="header-actions">

<button class="icon-btn" onclick="showPage('favorites')">
♡
<span class="badge" id="favCount">0</span>
</button>

<button class="icon-btn" onclick="showPage('cart')">
🛒
<span class="badge" id="cartCount">0</span>
</button>

</div>

</div>

</header>


<div class="app">

<!-- HOME -->

<div class="page active" id="home">

<div class="hero">

<div class="hero-content">

<div class="hero-label">
جودة تستحقها
</div>

<h1>
ذبائح ولحوم
طازجة لباب بيتك
</h1>

<p>
اختر منتجاتك، حدد عنوانك،
وادفع بسهولة واستلم طلبك بالطريقة التي تناسبك.
</p>

<button class="primary" onclick="document.getElementById('productsSection').scrollIntoView({behavior:'smooth'})">
تسوق الآن
</button>

</div>

</div>


<section>

<div class="section-head">

<h2>الأقسام</h2>

<button onclick="showPage('categories')">
عرض الكل
</button>

</div>

<div class="categories">

<div class="category" onclick="filterCategory('ذبائح')">

<img src="https://images.unsplash.com/photo-1545468258-94a7b6aab2a6?auto=format&fit=crop&w=600&q=80">

<div>الذبائح</div>

</div>

<div class="category" onclick="filterCategory('لحوم')">

<img src="https://images.unsplash.com/photo-1603048297172-c92544798d5a?auto=format&fit=crop&w=600&q=80">

<div>اللحوم</div>

</div>

<div class="category" onclick="filterCategory('دواجن')">

<img src="https://images.unsplash.com/photo-1604503468506-a8da13d82791?auto=format&fit=crop&w=600&q=80">

<div>الدواجن</div>

</div>

<div class="category" onclick="filterCategory('مستلزمات')">

<img src="https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=600&q=80">

<div>المستلزمات</div>

</div>

<div class="category" onclick="filterCategory('جاهز')">

<img src="https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=600&q=80">

<div>جاهز للطبخ</div>

</div>

</div>

</section>


<section id="productsSection">

<div class="section-head">

<h2>الأكثر طلباً</h2>

<button onclick="showPage('categories')">
كل المنتجات
</button>

</div>

<div class="products" id="homeProducts"></div>

</section>


<div class="offer">

<small>🔥 عرض خاص</small>

<h2>
خصم 15% على طلبك الأول
</h2>

<p>
استخدم الكود عند إتمام الطلب
</p>

<span class="coupon">
FIRST15
</span>

</div>


<section>

<div class="section-head">
<h2>تتبع طلبك</h2>
</div>

<div class="track">

<input
id="trackInput"
placeholder="مثال: DZ-1024"
>

<button onclick="trackOrder()">
تتبع
</button>

<div class="track-result" id="trackResult"></div>

</div>

</section>

</div>


<!-- CATEGORIES -->

<div class="page" id="categories">

<button class="back" onclick="showPage('home')">
← الرئيسية
</button>

<div class="section-head">
<h2 id="categoryTitle">كل المنتجات</h2>
</div>

<div class="categories" style="margin-bottom:25px">

<button class="category" onclick="filterCategory('الكل')">
<div style="padding:18px">الكل</div>
</button>

<button class="category" onclick="filterCategory('ذبائح')">
<div style="padding:18px">ذبائح</div>
</button>

<button class="category" onclick="filterCategory('لحوم')">
<div style="padding:18px">لحوم</div>
</button>

<button class="category" onclick="filterCategory('دواجن')">
<div style="padding:18px">دواجن</div>
</button>

</div>

<div class="products" id="allProducts"></div>

</div>


<!-- PRODUCT DETAILS -->

<div class="page" id="details">

<button class="back" onclick="showPage('home')">
← رجوع
</button>

<div class="details">

<div class="details-image">
<img id="detailImage">
</div>

<div class="details-info">

<h1 id="detailName"></h1>

<p id="detailDesc"></p>

<div class="details-price" id="detailPrice"></div>

<div class="qty">

<button onclick="changeDetailQty(-1)">
−
</button>

<span id="detailQty">1</span>

<button onclick="changeDetailQty(1)">
+
</button>

</div>

<button class="checkout-btn" onclick="addDetailToCart()">
أضف للسلة
</button>

</div>

</div>

</div>


<!-- CART -->

<div class="page" id="cart">

<button class="back" onclick="showPage('home')">
← متابعة التسوق
</button>

<div class="section-head">
<h2>سلة المشتريات</h2>
</div>

<div class="cart-list" id="cartList"></div>

<div class="summary">

<div class="summary-row">
<span>المجموع</span>
<b id="subtotal">0 ر.س</b>
</div>

<div class="summary-row">
<span>الخصم</span>
<b id="discount">0 ر.س</b>
</div>

<div class="summary-row">
<span>التوصيل</span>
<b id="delivery">25 ر.س</b>
</div>

<div class="summary-total">

<span>الإجمالي</span>

<span id="grandTotal">
0 ر.س
</span>

</div>

<button class="checkout-btn" onclick="showPage('checkout')">
إتمام الطلب
</button>

</div>

</div>


<!-- CHECKOUT -->

<div class="page" id="checkout">

<button class="back" onclick="showPage('cart')">
← السلة
</button>

<div class="section-head">
<h2>إتمام الطلب</h2>
</div>

<div class="form">

<div class="form-group">

<label>
الاسم
</label>

<input id="customerName" placeholder="اسمك الكامل">

</div>

<div class="form-group">

<label>
رقم الجوال
</label>

<input id="customerPhone" placeholder="05xxxxxxxx">

</div>

<div class="form-group">

<label>
العنوان
</label>

<input id="customerAddress" placeholder="الحي، الشارع، رقم المنزل">

</div>

<div class="form-group">

<label>
طريقة الاستلام
</label>

<select id="deliveryType">

<option>
توصيل إلى المنزل
</option>

<option>
استلام من الفرع
</option>

</select>

</div>

<div class="form-group">

<label>
طريقة الدفع
</label>

<div class="payment">

<div class="payment-option selected" onclick="selectPayment(this)">
💳 بطاقة
</div>

<div class="payment-option" onclick="selectPayment(this)">
🍎 Apple Pay
</div>

<div class="payment-option" onclick="selectPayment(this)">
💵 عند الاستلام
</div>

</div>

</div>

<button class="checkout-btn" onclick="createOrder()">
تأكيد الطلب
</button>

</div>

</div>


<!-- ORDERS -->

<div class="page" id="orders">

<button class="back" onclick="showPage('home')">
← الرئيسية
</button>

<div class="section-head">
<h2>طلباتي</h2>
</div>

<div id="ordersList"></div>

</div>


<!-- FAVORITES -->

<div class="page" id="favorites">

<button class="back" onclick="showPage('home')">
← الرئيسية
</button>

<div class="section-head">
<h2>المفضلة</h2>
</div>

<div class="products" id="favoritesList"></div>

</div>


<!-- ACCOUNT -->

<div class="page" id="account">

<div class="account-card">

<div style="font-size:15px">
مرحباً بك 👋
</div>

<h2 style="margin-top:10px">
عميل ذبيحة
</h2>

<div class="points">
850 نقطة
</div>

<div style="margin-top:5px;color:#dce9df">
نقاط الولاء الخاصة بك
</div>

</div>

<div class="account-menu">

<div class="account-item">
<span>👤 بيانات الحساب</span>
<span>›</span>
</div>

<div class="account-item" onclick="showPage('orders')">
<span>📦 طلباتي</span>
<span>›</span>
