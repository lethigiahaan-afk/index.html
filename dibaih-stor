desc:"لحم تيس طازج مناسب للطبخ والمناسبات."
},

{
id:5,
name:"دجاج طازج",
category:"دواجن",
price:24,
image:"https://images.unsplash.com/photo-1604503468506-a8da13d82791?auto=format&fit=crop&w=900&q=85",
desc:"دجاج طازج يتم تجهيزه حسب الطلب."
},

{
id:6,
name:"كبدة طازجة",
category:"لحوم",
price:35,
image:"https://images.unsplash.com/photo-1628268909376-e8c7e5f0f2c2?auto=format&fit=crop&w=900&q=85",
desc:"كبدة طازجة مختارة بعناية."
},

{
id:7,
name:"أرز فاخر 5 كيلو",
category:"مستلزمات",
price:42,
image:"https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=900&q=85",
desc:"أرز فاخر مناسب للولائم والمناسبات."
},

{
id:8,
name:"بهارات ذبائح",
category:"مستلزمات",
price:18,
image:"https://images.unsplash.com/photo-1596040033229-a9821ebd058d?auto=format&fit=crop&w=900&q=85",
desc:"خلطة بهارات مختارة للذبائح واللحوم."
},

{
id:9,
name:"كبسة جاهزة",
category:"جاهز",
price:75,
image:"https://images.unsplash.com/photo-1512058564366-18510be2db19?auto=format&fit=crop&w=900&q=85",
desc:"وجبة جاهزة بطعم منزلي."
},

{
id:10,
name:"مندي لحم",
category:"جاهز",
price:85,
image:"https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=900&q=85",
desc:"مندي لحم جاهز للتقديم."
}

];


/* STATE */

let cart=JSON.parse(localStorage.getItem("thbh_cart")||"[]");

let favorites=JSON.parse(localStorage.getItem("thbh_fav")||"[]");

let orders=JSON.parse(localStorage.getItem("thbh_orders")||"[]");

let currentProduct=null;

let detailQty=1;

let discount=0;


/* PAGE */

function showPage(id){

document.querySelectorAll(".page")
.forEach(p=>p.classList.remove("active"));

const page=document.getElementById(id);

if(page){
page.classList.add("active");
}

window.scrollTo({
top:0,
behavior:"smooth"
});

if(id==="cart") renderCart();

if(id==="orders") renderOrders();

if(id==="favorites") renderFavorites();

if(id==="categories") renderAllProducts();

}


/* NAV */

function setNav(button){

document.querySelectorAll(".bottom-item")
.forEach(b=>b.classList.remove("active"));

button.classList.add("active");

}


/* PRODUCTS */

function productCard(p){

const fav=favorites.includes(p.id);

return `

<div class="product">

<div class="product-image">

<img
src="${p.image}"
alt="${p.name}"
loading="lazy"
onclick="openProduct(${p.id})"
>

<button
class="favorite ${fav?'active':''}"
onclick="toggleFavorite(${p.id})"
>
${fav?'♥':'♡'}
</button>

</div>

<div class="product-info">

<h3 onclick="openProduct(${p.id})">
${p.name}
</h3>

<div class="product-desc">
${p.desc}
</div>

<div class="product-bottom">

<div class="price">
${p.price} ر.س
</div>

<button
class="add"
onclick="addToCart(${p.id})"
>
أضف
</button>

</div>

</div>

</div>

`;

}


function renderProducts(list,id){

const box=document.getElementById(id);

if(!box)return;

box.innerHTML=list.map(productCard).join("");

}


function renderHome(){

renderProducts(products.slice(0,8),"homeProducts");

}


function renderAllProducts(){

renderProducts(products,"allProducts");

}


/* FILTER */

function filterCategory(category){

showPage("categories");

const title=document.getElementById("categoryTitle");

if(category==="الكل"){

title.textContent="كل المنتجات";

renderProducts(products,"allProducts");

}else{

title.textContent=category;

renderProducts(
products.filter(p=>p.category===category),
"allProducts"
);

}

}


/* SEARCH */

function searchProducts(){

const value=
document.getElementById("searchInput")
.value
.toLowerCase()
.trim();

if(!value){

renderHome();

return;

}

showPage("categories");

const result=
products.filter(p=>
p.name.toLowerCase().includes(value) ||
p.category.toLowerCase().includes(value)
);

document.getElementById("categoryTitle")
.textContent="نتائج البحث";

renderProducts(result,"allProducts");

}


/* DETAILS */

function openProduct(id){

const p=products.find(x=>x.id===id);

if(!p)return;

currentProduct=p;

detailQty=1;

document.getElementById("detailImage").src=p.image;

document.getElementById("detailName").textContent=p.name;

document.getElementById("detailDesc").textContent=p.desc;

document.getElementById("detailPrice").textContent=p.price+" ر.س";

document.getElementById("detailQty").textContent=1;

showPage("details");

}


function changeDetailQty(amount){

detailQty+=amount;

if(detailQty<1)detailQty=1;

document.getElementById("detailQty")
.textContent=detailQty;

}


function addDetailToCart(){

if(!currentProduct)return;

for(let i=0;i<detailQty;i++){

addToCart(currentProduct.id,false);

}

showToast("تمت إضافة المنتج للسلة");

showPage("cart");

}


/* CART */

function addToCart(id,notify=true){

const existing=
cart.find(x=>x.id===id);

if(existing){

existing.qty++;

}else{

cart.push({
id:id,
qty:1
});

}

saveCart();

if(notify){

showToast("تمت إضافة المنتج للسلة");

}

}


function saveCart(){

localStorage.setItem(
"thbh_cart",
JSON.stringify(cart)
);

updateCartCount();

}


function updateCartCount(){

const count=
cart.reduce(
(sum,item)=>sum+item.qty,
0
);

document.getElementById("cartCount")
.textContent=count;

}


function renderCart(){

const box=
document.getElementById("cartList");

if(cart.length===0){

box.innerHTML=`

<div style="
background:#fff;
padding:40px;
border-radius:18px;
text-align:center
">

<div style="font-size:50px">
🛒
</div>

<h3 style="margin-top:15px">
السلة فارغة
</h3>

<p style="color:#777;margin-top:8px">
أضف منتجات للبدء بالطلب
</p>

<button
class="checkout-btn"
onclick="showPage('home')"
>
تصفح المنتجات
</button>

</div>

`;

updateSummary();

return;

}


box.innerHTML="";


cart.forEach(item=>{

const p=products.find(x=>x.id===item.id);

if(!p)return;

box.innerHTML+=`

<div class="cart-item">

<img src="${p.image}">

<div class="cart-item-info">

<b>${p.name}</b>

<div class="price">
${p.price} ر.س
</div>

<div class="cart-controls">

<button onclick="changeCartQty(${p.id},-1)">
−
</button>

<span>${item.qty}</span>

<button onclick="changeCartQty(${p.id},1)">
+
</button>

<button
class="delete"
onclick="removeCart(${p.id})"
>
حذف
</button>

</div>

</div>

</div>

`;

});

updateSummary();

}


function changeCartQty(id,amount){

const item=cart.find(x=>x.id===id);

if(!item)return;

item.qty+=amount;

if(item.qty<=0){

cart=cart.filter(x=>x.id!==id);

}

saveCart();

renderCart();

}


function removeCart(id){

cart=cart.filter(x=>x.id!==id);

saveCart();

renderCart();

showToast("تم حذف المنتج");

}


/* SUMMARY */

function updateSummary(){

let subtotal=0;

cart.forEach(item=>{

const p=products.find(x=>x.id===item.id);

if(p){

subtotal+=p.price*item.qty;

}

});

const delivery=subtotal>300?0:25;

const final=
Math.max(0,subtotal-discount)+delivery;

document.getElementById("subtotal")
.textContent=subtotal+" ر.س";

document.getElementById("discount")
.textContent=discount+" ر.س";

document.getElementById("delivery")
.textContent=delivery+" ر.س";

document.getElementById("grandTotal")
.textContent=final+" ر.س";

}


/* FAVORITES */

function toggleFavorite(id){

if(favorites.includes(id)){

favorites=
favorites.filter(x=>x!==id);

showToast("تمت إزالة المنتج من المفضلة");

}else{

favorites.push(id);

showToast("تمت إضافة المنتج للمفضلة");

}

localStorage.setItem(
"thbh_fav",
JSON.stringify(favorites)
);

document.getElementById("favCount")
.textContent=favorites.length;

renderHome();

}


function renderFavorites(){

const box=
document.getElementById("favoritesList");

const list=
products.filter(p=>favorites.includes(p.id));

if(list.length===0){

box.innerHTML=`

<div style="
grid-column:1/-1;
background:#fff;
padding:40px;
text-align:center;
border-radius:18px
">

<div style="font-size:50px">♡</div>

<h3>لا توجد منتجات مفضلة</h3>

</div>

`;

return;

}

box.innerHTML=list.map(productCard).join("");

}


/* ORDERS */

function createOrder(){

if(cart.length===0){

showToast("السلة فارغة");

showPage("cart");

return;

}

const name=
document.getElementById("customerName").value.trim();

const phone=
document.getElementById("customerPhone").value.trim();

const address=
document.getElementById("customerAddress").value.trim();

if(!name||!phone||!address){

alert("فضلاً أكمل بيانات الطلب");

return;

}

let total=0;

cart.forEach(item=>{

const p=products.find(x=>x.id===item.id);

if(p){

total+=p.price*item.qty;

}

});

const order={

id:"DZ-"+Math.floor(1000+Math.random()*9000),

date:new Date().toLocaleDateString("ar-SA"),

status:"جاري التجهيز",

name:name,

phone:phone,

address:address,

total:total,

items:cart.map(x=>{

const p=products.find(y=>y.id===x.id);

return {

name:p.name,

qty:x.qty

};

})

};

orders.unshift(order);

localStorage.setItem(
"thbh_orders",
JSON.stringify(orders)
);

cart=[];

discount=0;

saveCart();

alert(
"تم إنشاء طلبك بنجاح 🎉\n\n"+
"رقم الطلب: "+order.id
);

showPage("orders");

}


function renderOrders(){

const box=
document.getElementById("ordersList");

if(orders.length===0){

box.innerHTML=`

<div style="
background:#fff;
padding:40px;
text-align:center;
border-radius:18px
">

<div style="font-size:50px">
📦
</div>

<h3>لا توجد طلبات</h3>

</div>

`;

return;

}

box.innerHTML=orders.map(order=>`

<div class="order">

<div class="order-top">

<b>
طلب #${order.id}
</b>

<span class="status">
${order.status}
</span>

</div>

<div style="margin-top:10px">
${order.date}
</div>

<div class="order-items">

${order.items.map(i=>
`${i.name} × ${i.qty}`
).join("، ")}

</div>

<div style="
margin-top:10px;
font-weight:bold;
color:#17452d
">

${order.total} ر.س

</div>

<button
class="order-action"
onclick="trackSpecific('${order.id}')"
>
تتبع الطلب
</button>

</div>

`).join("");

}


function trackSpecific(id){

showPage("home");

document.getElementById("trackInput")
.value=id;

trackOrder();

document
.getElementById("trackInput")
.scrollIntoView({
behavior:"smooth"
});

}


function trackOrder(){

const id=
document.getElementById("trackInput")
.value.trim();

const result=
document.getElementById("trackResult");

if(!id){

result.innerHTML=
"⚠️ اكتب رقم الطلب أولاً";

return;

}

const order=
orders.find(x=>x.id===id);

if(!order){

result.innerHTML=
"❌ لم يتم العثور على الطلب";

return;

}

result.innerHTML=`

<div style="
background:#edf5ef;
padding:15px;
border-radius:12px;
color:#17452d
">

<b>
🟢 ${order.status}
</b>

<br><br>

رقم الطلب:
${order.id}

<br>

التاريخ:
${order.date}

</div>

`;

}


/* PAYMENT */

function selectPayment(el){

document
.querySelectorAll(".payment-option")
.forEach(x=>x.classList.remove("selected"));

el.classList.add("selected");

}


/* TOAST */

function showToast(message){

const toast=
document.getElementById("toast");

toast.textContent=message;

toast.classList.add("show");

setTimeout(()=>{

toast.classList.remove("show");

},2200);

}


/* INIT */

document.getElementById("favCount")
.textContent=favorites.length;

updateCartCount();

renderHome();

renderAllProducts();

</script>

